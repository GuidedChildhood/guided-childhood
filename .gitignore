# Next.js
.next/
out/

# Dependencies
node_modules/

# Build artifacts
tsconfig.tsbuildinfo

# Environment files — never commit real keys
.env
.env.local
.env.*.local

# Vercel
.vercel

# Misc
.DS_Store
*.pem
.claude/settings.local.json

# Rendered social cards, regenerate with tools/social-cards/render.mjs
tools/social-cards/out/

# The schools app manages its own modules and build
schools/node_modules/
schools/.next/
undefined/
.ux-shots/
__pycache__/

# HyperFrames video work (29 September 2026). The student kit's example renders
# and teaching project videos are 376 MB and re-clone from
# github.com/nateherkai/hyperframes-student-kit; its skills, scripts, docs and
# style library are what we use. Snapshots, renders and capture screenshots
# regenerate from the project files.
hyperframes-student-kit/**/*.mp4
hyperframes-student-kit/**/*.wav
hyperframes-student-kit/node_modules/
videos/*/snapshots/
videos/*/renders/
videos/*/*/renders/
videos/*/*/snapshots/
videos/*/capture/screenshots/
videos/*/node_modules/
videos/*/.media/
content/packs/2026-10-05-sb-launch-control/sb-launch-images.zip

# Read card PDFs are rebuilt from their JSON by tools/read-cards (7 October 2026)
content/read-cards/*.pdf
content/read-cards/*.html

# The Guided Planet (publishing/). The cache holds the verified character
# files and scratch copy; the print and ink PDFs regenerate from the issue
# file with `npm run planet -- render <n>`. The download PDF, previews and
# reports are kept so a pull request shows what the paper looks like.
publishing/.cache/
publishing/issues/*/dist/*-print.pdf
publishing/issues/*/dist/*-ink.pdf
publishing/issues/*/package-preview/
publishing/issues/*/state.json
publishing/issues/*/events.jsonl
