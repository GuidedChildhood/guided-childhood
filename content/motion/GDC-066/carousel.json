  "pages": [
    {
      "kicker": "AI and homework",
      "lines": [
        "Saying no to AI",
        "is not the same as",
        "==talking about it.=="
      ]
    },
    {
      "kicker": "What RAND found",
      "lines": [
        "About 1,000 US parents.",
        "56 percent encourage it.",
        "24 percent discourage it.",
        "==20 percent have not raised it.=="
      ]
    },
    {
      "kicker": "The shaky part",
      "lines": [
        "Teens who felt discouraged:",
        "==38 percent== used it anyway.",
        "A small, unweighted group.",
        "One snapshot, not proof."
      ]
    },
    {
      "kicker": "What it does not show",
      "lines": [
        "That rules change behaviour.",
        "That it holds in the UK.",
        "It is one US survey."
      ]
    },
    {
      "kicker": "What parents can do",
      "role": "practical",
      "lines": [
        "Be explicit, not only strict.",
