<!doctype html>
<html lang="en" data-composition-variables='[{"id":"parentCta","type":"boolean","label":"Parent end card (stage check)","default":true}]'>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=__W__, height=__H__" />
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
    <style>
      /* Planet Friends (Mission Control), the music video. Generated by build.py
         from film.tpl; edit the template, never index.html. Night comic
         look over the APPROVED cutouts only (brand/GDC_SOCIAL_VISUAL_SYSTEM.md
         section 1), house tokens and fonts only, no dashes in any on screen text. */
      @font-face { font-family: "Nunito"; src: url("ASSET/fonts/nunito-latin-wght-normal.woff2") format("woff2"); font-weight: 200 1000; }
      @font-face { font-family: "Plex Mono"; src: url("ASSET/fonts/ibm-plex-mono-latin-600-normal.woff2") format("woff2"); font-weight: 600; }
      @font-face { font-family: "Plex Mono"; src: url("ASSET/fonts/ibm-plex-mono-latin-700-normal.woff2") format("woff2"); font-weight: 700; }
      :root { --ink: #1a1a2e; --espresso: #2e2818; --cream: #f9f8f6; --gold: #edc35f; --burgundy: #6b2333; }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { width: __W__px; height: __H__px; overflow: hidden; background: var(--ink); }
      #root { width: 100%; height: 100%; position: relative; overflow: hidden; background: var(--ink); font-family: "Nunito", sans-serif; }
      #world { position: absolute; inset: 0; }
      .scene { position: absolute; inset: 0; opacity: 0; }
      .abs { position: absolute; }

      .spot {
        position: absolute; border-radius: 50%; background: var(--c);
        -webkit-mask-image: radial-gradient(circle, #000 46%, transparent 52%), radial-gradient(circle, #000 30%, transparent 70%);
        -webkit-mask-size: 22px 22px, 100% 100%; -webkit-mask-repeat: repeat, no-repeat; -webkit-mask-composite: source-in;
        mask-image: radial-gradient(circle, #000 46%, transparent 52%), radial-gradient(circle, #000 30%, transparent 70%);
        mask-size: 22px 22px, 100% 100%; mask-repeat: repeat, no-repeat; mask-composite: intersect;
      }
      .panel { position: absolute; border: 14px solid var(--cream); box-shadow: 18px 18px 0 var(--espresso); }
      .paper { background: var(--cream); border-color: var(--ink); outline: 14px solid var(--cream); }
      .paper::after {
        content: ""; position: absolute; inset: 0; pointer-events: none;
        background: radial-gradient(circle, rgba(26,26,46,0.2) 32%, transparent 36%) 0 0 / 15px 15px;
        -webkit-mask-image: linear-gradient(135deg, transparent 55%, #000 100%); mask-image: linear-gradient(135deg, transparent 55%, #000 100%);
      }
      .cw { position: absolute; }
      .cs, .ch { position: absolute; inset: 0; transform-origin: 50% 55%; }
      .cs {
        background: radial-gradient(circle, var(--espresso) 45%, transparent 50%) 0 0 / 12px 12px;
        -webkit-mask-size: contain; -webkit-mask-repeat: no-repeat; -webkit-mask-position: center;
        mask-size: contain; mask-repeat: no-repeat; mask-position: center;
      }
      .ch { width: 100%; height: 100%; object-fit: contain;
        filter: drop-shadow(6px 0 0 var(--ink)) drop-shadow(-6px 0 0 var(--ink)) drop-shadow(0 6px 0 var(--ink)) drop-shadow(0 -6px 0 var(--ink)); }
      .plate { position: absolute; padding: 14px 26px 12px; border: 5px solid var(--cream); background: var(--ink); color: var(--cream);
        font-family: "Plex Mono", monospace; font-weight: 700; font-size: 44px; letter-spacing: 0.32em; white-space: nowrap; }
      .plate small { display: block; margin-top: 6px; font-size: 18px; font-weight: 600; letter-spacing: 0.22em; color: var(--gold); }
      .lyrics { position: absolute; }
      .line { position: absolute; inset: 0; display: flex; flex-wrap: wrap; align-content: center; gap: 4px 0.22em; opacity: 0;
        font-weight: 900; line-height: 1.0; letter-spacing: -0.02em; color: var(--ink); text-shadow: 6px 5px 0 var(--ghost, rgba(201,154,40,0.55)); }
      .line.center { justify-content: center; text-align: center; }
      .w { display: inline-block; opacity: 0; }
      .hl { background: var(--gold); padding: 0 0.12em; box-shadow: 6px 6px 0 var(--ink); text-shadow: none; }
      .lesson { position: absolute; display: flex; align-items: center; justify-content: center; }
      .lesson .ltxt { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; opacity: 0;
        font-family: "Plex Mono", monospace; font-weight: 700; text-align: center; font-size: 26px; letter-spacing: 0.1em; line-height: 1.3; padding: 0 28px; }
      .lesson .ltxt b { display: block; font-size: 17px; letter-spacing: 0.3em; margin-bottom: 6px; opacity: 0.8; }
      .tape { position: absolute; z-index: 5; padding: 12px 30px 10px; transform-origin: 0 0; background: var(--gold); color: var(--ink);
        box-shadow: 0 6px 0 rgba(0,0,0,0.35); font-family: "Plex Mono", monospace; font-weight: 700; font-size: 24px; letter-spacing: 0.4em; white-space: nowrap; }
      .splat { position: absolute; border-radius: 50%; }
      .dim { position: absolute; inset: 0; background: var(--ink); opacity: 0; }
      .tag { position: absolute; left: 0; right: 0; bottom: 0; padding: 10px 0 8px; text-align: center; color: var(--cream);
        font-family: "Plex Mono", monospace; font-weight: 700; font-size: 22px; letter-spacing: 0.3em; }
      .card { position: absolute; background: var(--cream); border: 8px solid var(--ink); box-shadow: 10px 10px 0 var(--espresso); overflow: hidden; opacity: 0; }
      .card .band { position: absolute; left: 0; right: 0; top: 0; height: 16px; }
      .card .lab { position: absolute; left: 18px; right: 18px; top: 34px; font-family: "Plex Mono", monospace; font-weight: 700; font-size: 22px; letter-spacing: 0.12em; color: var(--ink); line-height: 1.25; }
      .card .sub { position: absolute; left: 18px; right: 18px; top: 104px; font-weight: 800; font-size: 28px; line-height: 1.1; color: var(--ink); }
      .card img { position: absolute; right: -6px; bottom: -6px; width: 104px; height: 104px; object-fit: contain; }
      .notif { position: absolute; width: 300px; height: 92px; border-radius: 22px; background: var(--cream); border: 5px solid var(--ink);
        box-shadow: 8px 8px 0 rgba(0,0,0,0.45); display: flex; align-items: center; gap: 16px; padding: 0 22px; opacity: 0;
        font-family: "Plex Mono", monospace; font-weight: 700; font-size: 24px; letter-spacing: 0.1em; color: var(--ink); }
      .notif i { width: 26px; height: 26px; border-radius: 50%; background: var(--c); flex: none; }
      .stamp { position: absolute; border: 8px solid var(--ink); color: var(--ink); font-family: "Plex Mono", monospace; font-weight: 700;
        letter-spacing: 0.18em; padding: 8px 18px; opacity: 0; background: rgba(249,248,246,0.85); }
      #endcard { position: absolute; background: var(--cream); border: 14px solid var(--ink); outline: 14px solid var(--cream);
        box-shadow: 22px 22px 0 var(--espresso); display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; opacity: 0; padding: 40px; }
      #endcard .eb { font-family: "Plex Mono", monospace; font-weight: 700; font-size: 24px; letter-spacing: 0.32em; color: var(--ink); opacity: 0.75; }
      #endcard .h { font-weight: 900; color: var(--ink); line-height: 1.0; letter-spacing: -0.02em; margin: 18px 0 14px; }
      #endcard .p { font-weight: 800; color: var(--ink); }
      #endcard .u { margin-top: 26px; font-family: "Plex Mono", monospace; font-weight: 700; font-size: 26px; letter-spacing: 0.12em; color: var(--ink);
        background: var(--gold); padding: 10px 22px; box-shadow: 6px 6px 0 var(--ink); }
      #grain { position: absolute; inset: -40px; pointer-events: none; opacity: 0.42; mix-blend-mode: soft-light;
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='300' height='300'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>"); }
      #vignette { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse at 45% 50%, rgba(0,0,0,0) 55%, rgba(10,10,20,0.55) 100%); }
    </style>
  </head>
  <body>
    <div id="root" data-composition-id="main" data-start="0" data-duration="__DUR__" data-width="__W__" data-height="__H__">
      <div id="world"></div>
      <div id="grain"></div>
      <div id="vignette"></div>
      <audio id="bgm" src="ASSET/bgm.mp3" data-start="0" data-duration="__DUR__" data-track-index="10" data-volume="1"></audio>
    </div>
    <script>
      /*DATA*/
      const { W, H, vertical: V, duration, beats, sections, plan, lessons, services } = DATA;
      const A = document.querySelector("#bgm").getAttribute("src").replace(/bgm\.mp3$/, "");
      const FR = {
        pebble: { name: "PEBBLE", stage: "STAGE 1 · AGES 4 TO 7", c: "#C99A28", soft: "#FBEED0", ink: "#7A5A0E" },
        bloop: { name: "BLOOP", stage: "STAGE 2 · AGES 8 TO 10", c: "#6C9E38", soft: "#E4F0D4", ink: "#3F5E1E" },
        orbit: { name: "ORBIT", stage: "STAGE 3 · AGES 11 TO 13", c: "#3E86BC", soft: "#DCEBF7", ink: "#1F4E6E" },
        nova: { name: "NOVA", stage: "STAGE 4 · AGES 13 TO 15", c: "#7E5AB0", soft: "#ECE3F7", ink: "#4A2F73" },
        cosmo: { name: "COSMO", stage: "STAGE 5 · AGES 16 AND UP", c: "#CE7328", soft: "#FBE4D0", ink: "#8F4A12" },
      };
      const ORDER = ["pebble", "bloop", "orbit", "nova", "cosmo"];
      const img = (k) => A + "friends/" + k + ".png";
      let parentCta = true;
      try { const v = window.__hyperframes.getVariables(); if (v && v.parentCta === false) parentCta = false; } catch (e) {}

      // Layouts. Every box is [x, y, w, h] in canvas pixels.
      const L = V ? {
        fs: 92, left: [60, 80, 960, 900], ch: [200, 230, 680, 680], plate: [100, 120], right: [60, 1040, 960, 560], lyr: [110, 1080, 860, 480],
        small: [90, 1660, 900, 170], spot: [40, 70, 1000, 1000], tape: [60, 900],
        slots: [[60, 80, 300, 400], [390, 80, 300, 400], [720, 80, 300, 400], [225, 520, 300, 400], [555, 520, 300, 400]],
        bar: [60, 1000, 960, 640], barLyr: [100, 1040, 880, 560], grid: [60, 80, 960, 900, 3], sright: [60, 1040, 960, 600], slyr: [110, 1080, 860, 520],
        end: [90, 520, 900, 760], endH: 96, endP: 48,
      } : {
        fs: 104, left: [70, 70, 1000, 940], ch: [240, 230, 680, 680], plate: [120, 120], right: [1100, 120, 750, 640], lyr: [1160, 175, 630, 530],
        small: [1140, 800, 680, 190], spot: [90, 110, 980, 980], tape: [40, 960],
        slots: [[70, 70, 340, 430], [430, 70, 340, 430], [790, 70, 340, 430], [1150, 70, 340, 430], [1510, 70, 340, 430]],
        bar: [70, 580, 1780, 420], barLyr: [130, 610, 1660, 360], grid: [70, 80, 990, 920, 4], sright: [1100, 120, 750, 840], slyr: [1160, 175, 630, 730],
        end: [360, 200, 1200, 680], endH: 110, endP: 52,
      };
      const bx = (b) => ({ left: b[0] + "px", top: b[1] + "px", width: b[2] + "px", height: b[3] + "px" });
      const mk = (tag, cls, parent, style, html) => { const e = document.createElement(tag); if (cls) e.className = cls; if (style) Object.assign(e.style, style); if (html != null) e.innerHTML = html; parent.appendChild(e); return e; };

      let seed = 11;
      const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647) - 0.5;
      const tl = gsap.timeline({ paused: true });
      const world = document.getElementById("world");
      const norm = (w) => w.toLowerCase().replace(/[^a-z0-9']/g, "");
      const HL = new Set("planet friends ban plan step sixteen connection protection door open yes no path child real pretend computer grown toothbrush private stop kind kindest routines gaming cost credit maker thirteen magnifier prize bill deepfakes trust bravest thinking print ding persuasion odds ramp pressure calm checklist source passport stamp stage check questions digi scripts stars chart faces quest letter homework guides schools lessons compass bridge truth whoops wifi's wild".split(" "));

      // Section windows: each scene opens a beat before its first word.
      const win = sections.map((s, i) => {
        const a = i === 0 ? 0 : Math.max(0, s.start - 0.35);
        const b = i + 1 < sections.length ? Math.max(0, sections[i + 1].start - 0.35) : duration;
        return [a, b];
      });
      // Word times, made monotonic within each section.
      sections.forEach((s) => { let last = -1; s.lines.forEach((l) => l.forEach((w) => { if (w[1] <= last) w[1] = last + 0.06; last = w[1]; })); });

      function chunks(line) {
        const out = []; let cur = [];
        line.forEach((w) => { cur.push(w); const stop = /[,?!.]$/.test(w[0]); if ((stop && cur.length >= 2) || cur.length >= 6) { out.push(cur); cur = []; } });
        if (cur.length) { if (cur.length < 2 && out.length) out[out.length - 1].push(...cur); else out.push(cur); }
        return out;
      }
      function fitSize(words, bw, bh, max) {
        const longest = Math.max(...words.map((w) => w[0].length));
        const chars = words.reduce((n, w) => n + w[0].length + 1, 0);
        for (let s = max; s > 40; s -= 4) {
          if (longest * 0.64 * s + 0.3 * s > bw) continue;
          const rows = Math.floor(bh / (s * 1.06));
          if (chars * 0.6 * s / (bw * 0.92) <= rows) return s;
        }
        return 40;
      }
      // Stamp a section's lines into a lyric box, chunk by chunk.
      function lyrics(box, sec, endT, opts = {}) {
        const all = [];
        sec.lines.forEach((l) => chunks(l).forEach((c) => all.push(c)));
        all.forEach((c, k) => {
          const line = mk("div", "line" + (opts.center ? " center" : ""), box);
          line.style.fontSize = fitSize(c, box.clientWidth || parseFloat(box.style.width), parseFloat(box.style.height), opts.max || L.fs) + "px";
          if (opts.ghost) line.style.setProperty("--ghost", opts.ghost);
          const t0 = c[0][1] - 0.06;
          const t1 = k + 1 < all.length ? all[k + 1][0][1] - 0.1 : endT;
          tl.set(line, { opacity: 1 }, t0);
          c.forEach(([word, t], j) => {
            const s = mk("span", "w" + (HL.has(norm(word)) ? " hl" : ""), line, null, word);
            tl.fromTo(s, { opacity: 0, scale: 1.5, rotation: j % 2 ? 4 : -4 }, { opacity: 1, scale: 1, rotation: 0, duration: 0.14, ease: "power4.out" }, t);
          });
          if (t1 < endT) tl.to(line, { opacity: 0, y: -18, duration: 0.1, ease: "power2.in" }, Math.max(t0 + 0.2, t1 - 0.1));
        });
      }
      function character(parent, k, b) {
        const cw = mk("div", "cw", parent, bx(b));
        const cs = mk("div", "cs", cw, { WebkitMaskImage: `url(${img(k)})`, maskImage: `url(${img(k)})` });
        const ch = mk("img", "ch", cw); ch.src = img(k); ch.alt = "";
        return { cw, cs, ch };
      }
      function spot(parent, b, c) { const s = mk("div", "spot", parent, bx(b)); s.style.setProperty("--c", c); return s; }
      function splats(parent, pts) { pts.forEach(([x, y, r, c, o]) => mk("div", "splat", parent, { left: x + "px", top: y + "px", width: r + "px", height: r + "px", background: c, opacity: o })); }
      function sceneShell(i) {
        const sc = mk("div", "scene", world); sc.id = "sc-" + i;
        tl.set(sc, { opacity: 1 }, win[i][0]);
        if (win[i][1] < duration) tl.set(sc, { opacity: 0 }, win[i][1]);
        return sc;
      }
      function thump(els, a, b) { beats.filter((t) => t >= a && t < b).forEach((t) => tl.fromTo(els, { scale: 1.05 }, { scale: 1, duration: 0.45, ease: "power2.out", immediateRender: false }, t)); }
      const lineStart = (sec, li) => sec.lines[li][0][1];
      const wordTime = (sec, li, word) => { const w = sec.lines[li].find((x) => norm(x[0]).startsWith(word)); return w ? w[1] : lineStart(sec, li); };

      // ---------- Group scenes: the line up and a lyric bar ----------
      function groupScene(i, p) {
        const sec = sections[i], [a, b] = win[i], sc = sceneShell(i);
        const slots = {};
        ORDER.forEach((k, n) => {
          const s = L.slots[n], f = FR[k];
          const pn = mk("div", "panel", sc, Object.assign(bx(s), { background: "var(--ink)", overflow: "hidden", borderWidth: "10px" }));
          const sp = spot(pn, [-s[2] * 0.25, -s[3] * 0.05, s[2] * 1.5, s[2] * 1.5], f.c);
          const c = character(pn, k, [s[2] * 0.06, s[3] * 0.08, s[2] * 0.82, s[2] * 0.82]);
          mk("div", "tag", pn, { background: f.ink }, f.name);
          const dim = mk("div", "dim", pn);
          slots[k] = { pn, sp, c, dim };
          tl.fromTo(pn, { opacity: 0, y: -50, rotation: (n % 2 ? 2 : -2) }, { opacity: 1, y: 0, rotation: (n % 2 ? 0.8 : -0.8), duration: 0.3, ease: "back.out(2)" }, a + (i === 0 ? 0.5 + n * 0.32 : 0.05 * n));
        });
        const bar = mk("div", "panel paper", sc, bx(L.bar));
        tl.fromTo(bar, { opacity: 0, y: 40 }, { opacity: 1, y: 0, duration: 0.3, ease: "power3.out" }, a + 0.1);
        const ly = mk("div", "lyrics", sc, bx(L.barLyr));
        lyrics(ly, sec, b, { center: true, max: V ? 96 : 120 });
        // Who is on the mic: the rapper's panel lifts, the rest dim.
        sec.lines.forEach((l, li) => {
          const who = p.who[li] || "all";
          const on = who === "all" ? ORDER : [].concat(who);
          const t = l[0][1] - 0.08;
          ORDER.forEach((k) => {
            const live = on.includes(k);
            tl.to(slots[k].dim, { opacity: live ? 0 : 0.55, duration: 0.15 }, t);
            tl.to(slots[k].pn, { y: live && on.length < 5 ? -14 : 0, duration: 0.2, ease: "power2.out" }, t);
          });
          // The crowd answer: every panel pops on "Planet Friends!"
          if (p.chorus) l.forEach(([w, t2]) => { if (norm(w) === "friends") tl.fromTo(ORDER.map((k) => slots[k].c.cw), { scale: 1.12 }, { scale: 1, duration: 0.35, ease: "back.out(3)", immediateRender: false }, t2); });
        });
        thump(ORDER.map((k) => slots[k].sp), a, b);
        if (p.end) endCard(sc, sec, b);
      }

      // ---------- A friend's verse ----------
      function verseScene(i, k) {
        const sec = sections[i], [a, b] = win[i], f = FR[k], sc = sceneShell(i);
        const sp = spot(sc, L.spot, f.c);
        const left = mk("div", "panel", sc, bx(L.left));
        const c = character(sc, k, L.ch);
        mk("div", "plate", sc, { left: L.plate[0] + "px", top: L.plate[1] + "px" }, `${f.name}<small>${f.stage}</small>`);
        const right = mk("div", "panel paper", sc, bx(L.right));
        const ly = mk("div", "lyrics", sc, bx(L.lyr));
        const small = mk("div", "panel lesson", sc, Object.assign(bx(L.small), { background: f.soft, borderColor: "var(--cream)", opacity: 0 }));
        const tape = mk("div", "tape", sc, { left: L.tape[0] + "px", top: L.tape[1] + "px" }, `PLANET FRIENDS &nbsp; ${f.name}`);
        const [lx, lyy, lw, lh] = L.left;
        splats(sc, [[lx + lw - 30, lyy - 10, 46, "#edc35f", 0.9], [lx + lw + 22, lyy - 30, 14, "#edc35f", 0.9], [lx - 10, lyy + lh - 20, 38, "#f9f8f6", 0.85], [lx + 40, lyy + lh + 20, 12, "#f9f8f6", 0.8]]);

        tl.fromTo(left, { opacity: 0, scale: 1.06 }, { opacity: 1, scale: 1, duration: 0.25, ease: "power3.out" }, a);
        tl.fromTo(right, { opacity: 0, x: 60, rotation: 3 }, { opacity: 1, x: 0, rotation: 1.2, duration: 0.3, ease: "back.out(2)" }, a + 0.08);
        tl.fromTo(sp, { opacity: 0, scale: 0.7 }, { opacity: 1, scale: 1, duration: 0.5, ease: "power2.out" }, a);
        tl.fromTo(tape, { opacity: 0, rotation: -10, x: -120 }, { opacity: 1, rotation: -6, x: 0, duration: 0.3, ease: "power3.out" }, a + 0.3);
        tl.fromTo(c.cw, { y: 140, opacity: 0 }, { y: 0, opacity: 1, duration: 0.45, ease: "back.out(1.6)" }, a + 0.1);
        tl.set(c.cs, { x: 26, y: 26 }, a);
        lyrics(ly, sec, b, { ghost: f.c + "88" });

        // The lessons this friend fronts, as a sticker that changes per line.
        const ls = lessons[k] || {};
        let firstLesson = null;
        const lt = Object.keys(ls).map(Number).sort((x, y) => x - y);
        lt.forEach((li, n) => {
          if (li >= sec.lines.length) return;
          const t = lineStart(sec, li);
          if (firstLesson === null) firstLesson = t;
          const txt = mk("div", "ltxt", small, { color: f.ink }, `<b>${li === 7 && k === "cosmo" ? "THE PASSPORT" : "THE LESSON"}</b>${ls[li]}`);
          tl.to(txt, { opacity: 1, duration: 0.12 }, t);
          tl.fromTo(txt, { scale: 0.7 }, { scale: 1, duration: 0.3, ease: "back.out(3)" }, t);
          const nxt = lt[n + 1];
          if (nxt !== undefined && nxt < sec.lines.length) tl.to(txt, { opacity: 0, duration: 0.1 }, lineStart(sec, nxt) - 0.1);
        });
        if (firstLesson !== null) tl.fromTo(small, { opacity: 0, y: 40, rotation: -4 }, { opacity: 1, y: 0, rotation: -1.5, duration: 0.3, ease: "back.out(2)" }, firstLesson - 0.15);
        thump([sp], a, b);
        GAGS[k](sc, sec, c, a, b);
      }

      // Each friend's running joke and habit, from digi-squad/README.md, done in
      // motion and code drawn props. The friends themselves are never redrawn.
      const [GX, GY, GW, GH] = L.left;
      const GAGS = {
        pebble(sc, sec, c, a, b) {
          tl.set([c.ch, c.cs], { rotation: 180 }, a);
          tl.to([c.ch, c.cs], { rotation: 168, duration: 0.12, yoyo: true, repeat: 3, ease: "sine.inOut" }, wordTime(sec, 0, "whoops"));
          const flip = lineStart(sec, 1);
          tl.to([c.ch, c.cs], { rotation: 360, duration: 0.55, ease: "back.out(1.8)" }, flip);
          for (let t = flip + 0.9; t < b - 0.4; t += 0.63) tl.to(c.cw, { rotation: Math.round((t - flip) / 0.63) % 2 ? 4 : -4, duration: 0.3, ease: "sine.inOut", overwrite: "auto" }, t);
        },
        bloop(sc, sec, c, a, b) {
          const piece = "M0 40 H45 A20 20 0 1 1 85 40 H130 V85 A20 20 0 1 1 130 125 V170 H0 Z";
          const x = GX + GW * 0.7, y = GY + GH * 0.12;
          const slot = mk("div", "abs", sc, { left: x + "px", top: y + "px", width: "190px", height: "210px", opacity: 0 },
            `<svg width="190" height="210" viewBox="-10 -10 190 210"><path d="${piece}" fill="none" stroke="#f9f8f6" stroke-width="7" stroke-dasharray="14 10"/><text x="65" y="128" font-family="Nunito" font-weight="900" font-size="80" fill="#f9f8f6" text-anchor="middle">?</text></svg>`);
          const pc = mk("div", "abs", sc, { left: x + "px", top: y + "px", width: "190px", height: "210px", opacity: 0 },
            `<svg width="190" height="210" viewBox="-10 -10 190 210"><path d="${piece}" fill="#edc35f" stroke="#1a1a2e" stroke-width="7"/></svg>`);
          tl.fromTo(slot, { opacity: 0, scale: 0.6 }, { opacity: 1, scale: 1, duration: 0.25, ease: "back.out(2)" }, wordTime(sec, 0, "missing"));
          const found = lineStart(sec, 1);
          tl.fromTo(pc, { opacity: 1, x: -260, y: 520, rotation: -200 }, { opacity: 1, x: 0, y: 0, rotation: 0, duration: 0.5, ease: "back.out(1.4)" }, found);
          tl.to(slot, { opacity: 0, duration: 0.1 }, found + 0.45);
          tl.to([pc], { opacity: 0, scale: 0.5, duration: 0.2 }, lineStart(sec, 2) + 1.5);
          // Taps the controller against a palm, twice, thinking: a double bob per line.
          sec.lines.forEach((l, li) => { const t = l[0][1] - 0.5; tl.to(c.cw, { y: -16, duration: 0.1, yoyo: true, repeat: 3, ease: "power1.inOut" }, t); });
        },
        orbit(sc, sec, c, a, b) {
          const t1 = lineStart(sec, 1), t2 = lineStart(sec, 2);
          const cx = GX + GW * 0.6, cy = GY + GH * 0.1;
          const card = mk("div", "abs", sc, { left: cx + "px", top: cy + "px", width: "330px", padding: "18px 22px", background: "#f9f8f6", border: "6px solid #1a1a2e", boxShadow: "10px 10px 0 #2e2818",
            fontFamily: "'Plex Mono', monospace", fontWeight: 700, fontSize: "28px", letterSpacing: "0.08em", color: "#1a1a2e", textAlign: "center", opacity: 0 }, "FREE PRIZE!<br>TAP TO CLAIM");
          const mag = mk("div", "abs", sc, { left: (cx - 40) + "px", top: (cy - 70) + "px", width: "420px", height: "420px", opacity: 0 },
            `<svg width="420" height="420" viewBox="0 0 420 420"><line x1="270" y1="270" x2="400" y2="400" stroke="#1a1a2e" stroke-width="58" stroke-linecap="round"/><line x1="270" y1="270" x2="395" y2="395" stroke="#f9f8f6" stroke-width="40" stroke-linecap="round"/><circle cx="170" cy="170" r="140" fill="rgba(220,235,247,0.28)" stroke="#1a1a2e" stroke-width="44"/><circle cx="170" cy="170" r="140" fill="none" stroke="#3E86BC" stroke-width="26"/><path d="M90 110 A100 100 0 0 1 150 70" stroke="#f9f8f6" stroke-width="12" fill="none" stroke-linecap="round"/></svg>`);
          const st = mk("div", "stamp", sc, { left: (cx + 20) + "px", top: (cy + 30) + "px", fontSize: "40px" }, "CHECKED");
          tl.fromTo(card, { opacity: 0, rotation: 8, scale: 0.6 }, { opacity: 1, rotation: 4, scale: 1, duration: 0.3, ease: "back.out(2)" }, t1 - 0.2);
          tl.fromTo(mag, { opacity: 1, x: 700, y: 120, rotation: 20 }, { opacity: 1, x: 0, y: 0, rotation: 0, duration: 0.7, ease: "power3.out" }, t1 + 0.2);
          tl.fromTo(st, { opacity: 0, scale: 2.4, rotation: -4 }, { opacity: 1, scale: 1, rotation: -12, duration: 0.18, ease: "power4.in" }, wordTime(sec, 1, "bill"));
          tl.to([card, mag, st], { opacity: 0, y: -30, duration: 0.25 }, t2 + 0.4);
          // Tilts the head, one beat, before answering.
          sec.lines.forEach((l) => { const t = l[0][1] - 0.6; tl.to(c.cw, { rotation: 7, duration: 0.18, yoyo: true, repeat: 1, ease: "sine.inOut" }, t); });
        },
        nova(sc, sec, c, a, b) {
          const pts = [[GX + GW * 0.04, GY + GH * 0.24], [GX + GW * 0.66, GY + GH * 0.3], [GX + GW * 0.08, GY + GH * 0.58], [GX + GW * 0.62, GY + GH * 0.64]];
          const txt = ["NEW", "3 NEW", "TAP NOW", "NEW"];
          const times = sec.lines[0].filter((w) => /ding|ring|look/.test(norm(w[0]))).map((w) => w[1]);
          while (times.length < 4) times.push((times[times.length - 1] || lineStart(sec, 0)) + 0.4);
          const ns = pts.map((p, n) => { const e = mk("div", "notif", sc, { left: p[0] + "px", top: p[1] + "px" }, `<i></i>${txt[n]}`); e.style.setProperty("--c", FR.nova.c); return e; });
          ns.forEach((e, n) => tl.fromTo(e, { opacity: 0, scale: 0.4, rotation: n % 2 ? 6 : -6 }, { opacity: 1, scale: 1, rotation: n % 2 ? 3 : -3, duration: 0.22, ease: "back.out(3)" }, times[n]));
          const off = wordTime(sec, 1, "sill");
          tl.to(ns, { x: -900, opacity: 0, duration: 0.5, ease: "power2.in", stagger: 0.06 }, off - 0.2);
          // Stillness: one deliberate move, on "I had that wrong", then stop.
          tl.to(c.cw, { y: 10, duration: 0.25, ease: "power2.inOut" }, lineStart(sec, 7));
        },
        cosmo(sc, sec, c, a, b) {
          const x = GX + GW * 0.66, y = GY + GH * 0.1;
          const rows = Array.from({ length: 8 }, (_, n) => `<div style="display:flex;align-items:center;gap:14px;height:46px;border-bottom:3px solid rgba(26,26,46,.25)"><span class="bx" style="width:28px;height:28px;border:4px solid #1a1a2e;display:inline-flex;align-items:center;justify-content:center;font-weight:900;font-size:26px;color:#CE7328">${n === 0 ? "<b class='tick' style='opacity:0'>✓</b>" : ""}</span><span style="flex:1;height:10px;background:rgba(26,26,46,.18)"></span></div>`).join("");
          const list = mk("div", "abs", sc, { left: x + "px", top: y + "px", width: "260px", padding: "18px 20px", background: "#f9f8f6", border: "6px solid #1a1a2e", boxShadow: "10px 10px 0 #2e2818", transformOrigin: "50% 0", opacity: 0 }, rows);
          const tick = list.querySelector(".tick");
          tl.fromTo(list, { opacity: 1, scaleY: 0.12 }, { opacity: 1, scaleY: 1, duration: 0.45, ease: "power3.out" }, wordTime(sec, 0, "long"));
          tl.to(list, { scale: 0.42, duration: 0.4, ease: "back.out(1.6)" }, wordTime(sec, 0, "small"));
          tl.to(tick, { opacity: 1, duration: 0.05 }, wordTime(sec, 1, "tick"));
          tl.fromTo(tick, { scale: 2 }, { scale: 1, duration: 0.2, ease: "back.out(3)" }, wordTime(sec, 1, "tick"));
          tl.to(list, { opacity: 0, duration: 0.2 }, lineStart(sec, 2) + 1.2);
          const pp = mk("div", "abs", sc, { left: (GX + GW * 0.7) + "px", top: (GY + GH * 0.2) + "px", width: "250px", height: "340px", background: "var(--burgundy)", border: "6px solid #1a1a2e",
            boxShadow: "12px 12px 0 #2e2818", borderRadius: "14px", display: "flex", flexDirection: "column", alignItems: "center", justifyContent: "center", gap: "14px", opacity: 0,
            fontFamily: "'Plex Mono', monospace", fontWeight: 700, color: "#edc35f", textAlign: "center", letterSpacing: "0.2em", fontSize: "26px", lineHeight: 1.3 }, "PASSPORT<br>TO<br>SIXTEEN");
          const st = mk("div", "abs", sc, { left: (GX + GW * 0.7 + 130) + "px", top: (GY + GH * 0.2 + 220) + "px", width: "150px", height: "150px", borderRadius: "50%", border: "8px solid #edc35f",
            color: "#edc35f", fontWeight: 900, fontSize: "64px", display: "flex", alignItems: "center", justifyContent: "center", opacity: 0, background: "rgba(107,35,51,0.6)" }, "16");
          const tp = lineStart(sec, 7);
          tl.fromTo(pp, { opacity: 0, x: 300, rotation: 14 }, { opacity: 1, x: 0, rotation: 5, duration: 0.4, ease: "back.out(1.6)" }, tp);
          tl.fromTo(st, { opacity: 0, scale: 2.6, rotation: 20 }, { opacity: 1, scale: 1, rotation: -8, duration: 0.18, ease: "power4.in" }, wordTime(sec, 7, "stamp"));
          // Finishes the thing in hand before speaking: a small settle per line.
          sec.lines.forEach((l) => tl.fromTo(c.cw, { y: -6 }, { y: 0, duration: 0.3, ease: "power2.out", immediateRender: false }, l[0][1] - 0.3));
        },
      };

      // ---------- The bridge: not a ban, it's a plan ----------
      function bridgeScene(i) {
        const sec = sections[i], [a, b] = win[i], sc = sceneShell(i);
        const cols = [FR.pebble.c, FR.bloop.c, FR.orbit.c];
        sec.lines.forEach((l, li) => {
          const t0 = l[0][1] - 0.08, t1 = li + 1 < sec.lines.length ? sec.lines[li + 1][0][1] - 0.08 : b;
          const bg = mk("div", "abs", sc, { inset: "0", background: cols[li % 3], opacity: 0 });
          const box = mk("div", "abs", sc, { left: "6%", right: "6%", top: "18%", bottom: "18%", display: "flex", flexWrap: "wrap", alignContent: "center", justifyContent: "center", gap: "0 0.25em",
            fontWeight: 900, fontSize: (V ? 150 : 210) + "px", lineHeight: 0.95, color: "#1a1a2e", textAlign: "center", letterSpacing: "-0.03em", textShadow: "10px 9px 0 rgba(249,248,246,0.6)", opacity: 0 });
          tl.set([bg, box], { opacity: 1 }, t0);
          if (t1 < b) tl.set([bg, box], { opacity: 0 }, t1);
          l.forEach(([w, t], j) => {
            const s = mk("span", "w", box, null, w.toUpperCase());
            tl.fromTo(s, { opacity: 0, scale: 1.8 }, { opacity: 1, scale: 1, duration: 0.12, ease: "power4.out" }, t);
          });
        });
      }

      // ---------- The services verse: a card per line, joined by the gold path ----------
      function servicesScene(i) {
        const sec = sections[i], [a, b] = win[i], sc = sceneShell(i);
        const [gx, gy, gw, gh, cols] = L.grid, rowsN = Math.ceil(services.length / cols), gap = 22;
        const cw = (gw - gap * (cols - 1)) / cols, chh = (gh - gap * (rowsN - 1)) / rowsN;
        const right = mk("div", "panel paper", sc, bx(L.sright));
        const ly = mk("div", "lyrics", sc, bx(L.slyr));
        tl.fromTo(right, { opacity: 0, x: 60 }, { opacity: 1, x: 0, duration: 0.3, ease: "back.out(2)" }, a);
        const centers = [];
        const svg = mk("div", "abs", sc, { left: "0", top: "0", width: W + "px", height: H + "px" });
        services.forEach(([k, lab, sub], n) => {
          const r = Math.floor(n / cols), cc = r % 2 ? cols - 1 - (n % cols) : n % cols; // snake, so the path flows
          const x = gx + cc * (cw + gap), y = gy + r * (chh + gap);
          centers.push([x + cw / 2, y + chh / 2]);
          const card = mk("div", "card", sc, bx([x, y, cw, chh]));
          mk("div", "band", card, { background: FR[k].c });
          mk("div", "lab", card, null, lab);
          mk("div", "sub", card, null, sub);
          const im = mk("img", "", card); im.src = img(k); im.alt = "";
          const t = n < sec.lines.length ? lineStart(sec, n) : a + n;
          tl.fromTo(card, { opacity: 0, scale: 1.4, rotation: n % 2 ? 6 : -6 }, { opacity: 1, scale: 1, rotation: n % 2 ? 1.5 : -1.5, duration: 0.2, ease: "power4.out" }, t - 0.05);
        });
        const d = "M" + centers.map((p) => p.map(Math.round).join(" ")).join(" L");
        svg.innerHTML = `<svg width="${W}" height="${H}"><path id="path-s" d="${d}" fill="none" stroke="#edc35f" stroke-width="14" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
        sc.insertBefore(svg, sc.firstChild);
        const path = svg.querySelector("path"), len = centers.reduce((n, p, j) => j ? n + Math.hypot(p[0] - centers[j - 1][0], p[1] - centers[j - 1][1]) : 0, 0);
        path.style.strokeDasharray = len; path.style.strokeDashoffset = len;
        const tEnd = lineStart(sec, Math.min(sec.lines.length, services.length) - 1);
        tl.to(path, { strokeDashoffset: 0, duration: tEnd - lineStart(sec, 0), ease: "none" }, lineStart(sec, 0));
        lyrics(ly, sec, b, {});
      }

      // ---------- The end card ----------
      function endCard(sc, sec, b) {
        const t = sec.lines.length > 1 ? lineStart(sec, 1) + 2.4 : b - 5;
        const ec = mk("div", "", sc, bx(L.end)); ec.id = "endcard";
        ec.innerHTML = parentCta
          ? `<div class="eb">FOR GROWN UPS</div><div class="h" style="font-size:${L.endH}px">What stage is your child?</div><div class="p" style="font-size:${L.endP}px">Three questions, no sign up.</div><div class="u">guidedchildhood.com/starter-pack</div>`
          : `<div class="eb">GUIDED CHILDHOOD</div><div class="h" style="font-size:${L.endH * 1.2}px">Planet Friends</div><div class="p" style="font-size:${L.endP}px">Step by step to sixteen.</div>`;
        // The line up and lyrics step back so the card is the only thing to read.
        tl.to(Array.from(sc.children).filter((e) => e !== ec), { opacity: 0, duration: 0.3 }, Math.min(t, b - 3) - 0.1);
        tl.fromTo(ec, { opacity: 0, scale: 0.8, rotation: -3 }, { opacity: 1, scale: 1, rotation: -1, duration: 0.4, ease: "back.out(2)" }, Math.min(t, b - 3));
      }

      plan.forEach((p, i) => {
        if (p.kind === "group") groupScene(i, p);
        else if (p.kind === "verse") verseScene(i, p.friend);
        else if (p.kind === "bridge") bridgeScene(i);
        else if (p.kind === "services") servicesScene(i);
      });

      // On every beat the grain boils; on every other beat the print slips.
      beats.forEach((t, n) => {
        tl.set("#grain", { x: Math.round(rnd() * 60), y: Math.round(rnd() * 60) }, t);
        if (n % 2 === 0) { tl.set("#world", { x: Math.round(rnd() * 8), y: Math.round(rnd() * 6) }, t); tl.set("#world", { x: 0, y: 0 }, t + 0.067); }
      });

      window.__timelines["main"] = tl;
    </script>
  </body>
</html>
