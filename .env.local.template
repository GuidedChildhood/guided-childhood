# Copy this file to .env.local and fill in values from each provider's dashboard.
# NEVER put real values in this template or commit .env.local to git.
# Keys go from provider website into Vercel env vars only. Never into chat, email, or code.
#
# ── SETTING UP A NEW MACHINE, READ THIS FIRST ────────────────────────────────
#
# Do not fill this in by hand. Vercel already holds every one of these for the
# live project, so it is the source of truth and it cannot go stale:
#
#     npm i -g vercel  &&  vercel link  &&  vercel env pull .env.local
#
# One command, every key, nothing carried between machines on a stick. This
# template exists to say what each key IS and what breaks without it, which is
# the part a pull cannot tell you.
#
# ── WHAT IS NOT IN HERE ──────────────────────────────────────────────────────
#
# Vercel sets NODE_ENV, VERCEL_ENV, NEXT_PUBLIC_VERCEL_ENV, VERCEL_DEPLOYMENT_ID
# and VERCEL_GIT_COMMIT_SHA itself. Nothing to set.
#
# The GC_ prefixed vars, plus CHROME, SHOTS, OUT, BASE and ROLL_TODAY, are
# one off switches for scripts in tools/ and scripts/. They are read where they
# are used and documented in those files, never needed to run the app.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Dashboard → project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ─── Anthropic ───────────────────────────────────────────────────────────────
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# ─── Stripe ──────────────────────────────────────────────────────────────────
# dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs — dashboard.stripe.com → Products → click product → copy price ID
STRIPE_PRICE_FOUNDER=        # £7.99/month recurring (Founder Rate, capped at 50)
STRIPE_PRICE_STANDARD=       # £12.99/month recurring (Standard)
STRIPE_PRICE_ANNUAL=         # £99/year recurring (Annual)
STRIPE_PRICE_SCHOOL_SMALL=   # £299/year (School Small, up to 200 pupils)
STRIPE_PRICE_SCHOOL_MEDIUM=  # £499/year (School Medium, 200+ pupils)

# ─── App ─────────────────────────────────────────────────────────────────────
# Platform lives at app.guidedchildhood.com — separate Vercel project from the static site
NEXT_PUBLIC_APP_URL=https://app.guidedchildhood.com

# ─── Social media law ────────────────────────────────────────────────────────
# Drives Stage 4 DiGi content and scripts without a code rewrite.
# Values: none | partial_ban | full_ban_u16
# UK state June 2026: ban confirmed, Regulations live Spring 2027
# Switch to full_ban_u16 when the ban goes live
NEXT_PUBLIC_SOCIAL_MEDIA_LAW=partial_ban

# Optional — override the default banned platform list (comma-separated, no spaces)
# Default: Instagram,YouTube,TikTok,Snapchat,Facebook,X
# Update when UK Regulations publish the final platform list
# BANNED_PLATFORMS=Instagram,YouTube,TikTok,Snapchat,Facebook,X

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# resend.com → API Keys. Verify the guidedchildhood.com domain first.
# Without RESEND_API_KEY the app runs fine and simply skips all email.
RESEND_API_KEY=
EMAIL_FROM="Justin at Guided Childhood <hello@guidedchildhood.com>"

# Shared secret for Vercel Cron routes (push and email). Any long random string.
CRON_SECRET=

# ─── DiGi ────────────────────────────────────────────────────────────────────
# Swappable without a redeploy. Default is claude-fable-5-1.
# Fallback chain in lib/config/digi.ts: claude-fable-5-1 → claude-opus-5 → claude-sonnet-5
DIGI_MODEL=claude-fable-5-1
# Where DiGi's researchers come from: file (digi/02-scientists.md in every
# prompt, the default) or retrieval (expert_knowledge, six findings per
# question). Score both with POST /api/admin/digi-evals?research=both first.
DIGI_RESEARCH_BASE=file

# ── Schools access gate (schools.guidedchildhood.com only) ──
# Codes that open the curriculum, the lessons and the printables. Comma
# separated, one per school or one per pilot cohort. Removing a code locks
# that school out on its next request.
SCHOOLS_ACCESS_CODES=oakfield-2026
# Pilot codes, one per school, as code:phase. A pilot code opens the two
# lessons for that phase (schools/lib/pilot.ts) plus the Hub, nothing else.
# Phases: primary, secondary, post16, all_through. A bare code means all
# through. Move a school to SCHOOLS_ACCESS_CODES when it takes a licence.
SCHOOLS_PILOT_CODES=stmarys-2026:primary,kingsoak-2026:secondary
# Signs the access cookie. Any long random string. Changing it signs every
# school out at once, which is the emergency lever if a code ever leaks.
SCHOOLS_ACCESS_SECRET=

# One tap sign in. Comma separated, from: google, apple.
# UNSET MEANS NO BUTTONS, which is the safe default: a provider that has not
# been switched on in Supabase answers "Unsupported provider" when a parent
# taps it, on the last screen before they pay us. Switch the provider on in
# Supabase first (Authentication, Sign In / Providers), then set this.
# Google is free. Apple needs a paid Apple Developer Program membership, so
# `google` on its own is a normal thing to run.
NEXT_PUBLIC_AUTH_PROVIDERS=

# ─── Push notifications ──────────────────────────────────────────────────────
# Generate once with:  npx web-push generate-vapid-keys
#
# THESE TWO ARE WHY THIS SECTION EXISTS. lib/push/send.ts returns early and
# sends NOTHING when either is missing, with no error and no log. Push simply
# stops, and everything else carries on looking healthy, which is the worst
# way for a thing to break. They were read by the code and absent from this
# file until 19 September 2026.
VAPID_EMAIL=            # mailto:you@yourdomain.com, required format
VAPID_PRIVATE_KEY=

# Optional. The PUBLIC key is not a secret and lib/config/vapid.ts bakes a
# working one in as a fallback, so leave this unset unless you have rotated
# the pair. Set it and the private key together or subscriptions break.
NEXT_PUBLIC_VAPID_KEY=

# ─── Semantic search ─────────────────────────────────────────────────────────
# Voyage AI, used to match DiGi's memory and the research bank by MEANING
# rather than by keyword.
#
# Missing is not fatal and is not visible either: searchKnowledge and the
# memory lookup return nothing at all and DiGi quietly falls back to the
# keyword pass. It answers, slightly worse, for ever, and nothing says so.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=        # optional, defaults to voyage-3.5-lite

# ─── Inbound email and webhooks ──────────────────────────────────────────────
# Signing secrets. Each one makes its route REJECT everything when unset, so
# the symptom is a feature that never fires rather than an insecure one.
RESEND_WEBHOOK_SECRET=            # delivery and bounce events from Resend
RESEND_INBOUND_SIGNING_SECRET=    # inbound parsing, falls back to the above
SCHOOL_INBOUND_SECRET=            # the school letterbox
SCHOOL_INBOUND_DOMAIN=            # optional, defaults to the inbox domain

# ─── Where things reach a human ──────────────────────────────────────────────
FOUNDER_EMAILS=         # comma separated, who counts as a founder account
FOUNDER_NOTIFY_EMAIL=   # optional, defaults to Justin, gets the alerts
SHOP_FULFILMENT_EMAIL=  # where a shop order goes to be posted out

# ─── Tuning, all optional, all with working defaults ─────────────────────────
# Set none of these and the product runs exactly as it ships. They are here so
# a value can be found when someone goes looking for where a number lives.
DIGI_CHAT_EFFORT=       # reasoning effort for the chat turn, default medium
DIGI_FAST_MODE=         # set to turn the faster path on
AI_UPDATE_MODEL=        # model for the AI updates refresh, defaults to DIGI_MODEL
NEXT_PUBLIC_STAR_MINUTES=   # minutes one star buys, per child rate lives in the DB
PLANET_FRIENDS=         # set to `live` to turn Planet Friends on, off otherwise
PLANET_FRIENDS_PREVIEW_KEY=  # opens it for a preview link while it is off
STRIPE_TOS_CONSENT=     # set to `on` to record terms consent through Stripe
SUPABASE_SERVICE_ROLE_KEY=   # only an alias fallback for SUPABASE_SERVICE_KEY above

# ─── Dev harness only, never set in production ───────────────────────────────
# Read by app/dev/lesson-player, which is a fixture page that 404s in
# production like every other route under /dev. Both point at a JSON file of
# REAL rows, so a wall layout is measured against what a classroom would
# actually show rather than against invented sample text. Unset is the normal
# state and the page falls back to its built in slides.
GC_DEV_SLIDES=          # path to a JSON file of lesson slides
GC_DEV_CYCLES=          # path to a JSON file of named learning cycles
