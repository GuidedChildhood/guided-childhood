# Copy this file to .env.local and fill in values from each provider's dashboard.
# NEVER put real values in this template or commit .env.local to git.
# Keys go from provider website into Vercel env vars only. Never into chat, email, or code.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Dashboard → project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ─── Anthropic ───────────────────────────────────────────────────────────────
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# ─── Stripe ──────────────────────────────────────────────────────────────────
# dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs — dashboard.stripe.com → Products → click product → copy price ID
STRIPE_PRICE_FOUNDER=        # £7.99/month recurring (Founder Rate, capped at 50)
STRIPE_PRICE_STANDARD=       # £12.99/month recurring (Standard)
STRIPE_PRICE_ANNUAL=         # £99/year recurring (Annual)
STRIPE_PRICE_SCHOOL_SMALL=   # £299/year (School Small, up to 200 pupils)
STRIPE_PRICE_SCHOOL_MEDIUM=  # £499/year (School Medium, 200+ pupils)

# ─── App ─────────────────────────────────────────────────────────────────────
# Platform lives at app.guidedchildhood.com — separate Vercel project from the static site
NEXT_PUBLIC_APP_URL=https://app.guidedchildhood.com

# ─── Social media law ────────────────────────────────────────────────────────
# Drives Stage 4 DiGi content and scripts without a code rewrite.
# Values: none | partial_ban | full_ban_u16
# UK state June 2026: ban confirmed, Regulations live Spring 2027
# Switch to full_ban_u16 when the ban goes live
NEXT_PUBLIC_SOCIAL_MEDIA_LAW=partial_ban

# Optional — override the default banned platform list (comma-separated, no spaces)
# Default: Instagram,YouTube,TikTok,Snapchat,Facebook,X
# Update when UK Regulations publish the final platform list
# BANNED_PLATFORMS=Instagram,YouTube,TikTok,Snapchat,Facebook,X

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# resend.com → API Keys. Verify the guidedchildhood.com domain first.
# Without RESEND_API_KEY the app runs fine and simply skips all email.
RESEND_API_KEY=
EMAIL_FROM="Justin at Guided Childhood <hello@guidedchildhood.com>"

# Shared secret for Vercel Cron routes (push and email). Any long random string.
CRON_SECRET=

# ─── DiGi ────────────────────────────────────────────────────────────────────
# Swappable without a redeploy. Default is claude-fable-5-1.
# Fallback chain in lib/config/digi.ts: claude-fable-5-1 → claude-opus-5 → claude-sonnet-5
DIGI_MODEL=claude-fable-5-1
# Where DiGi's researchers come from: file (digi/02-scientists.md in every
# prompt, the default) or retrieval (expert_knowledge, six findings per
# question). Score both with POST /api/admin/digi-evals?research=both first.
DIGI_RESEARCH_BASE=file

# ── Schools access gate (schools.guidedchildhood.com only) ──
# Codes that open the curriculum, the lessons and the printables. Comma
# separated, one per school or one per pilot cohort. Removing a code locks
# that school out on its next request.
SCHOOLS_ACCESS_CODES=oakfield-2026
# Pilot codes, one per school, as code:phase. A pilot code opens the two
# lessons for that phase (schools/lib/pilot.ts) plus the Hub, nothing else.
# Phases: primary, secondary, post16, all_through. A bare code means all
# through. Move a school to SCHOOLS_ACCESS_CODES when it takes a licence.
SCHOOLS_PILOT_CODES=stmarys-2026:primary,kingsoak-2026:secondary
# Signs the access cookie. Any long random string. Changing it signs every
# school out at once, which is the emergency lever if a code ever leaks.
SCHOOLS_ACCESS_SECRET=

# One tap sign in. Comma separated, from: google, apple.
# UNSET MEANS NO BUTTONS, which is the safe default: a provider that has not
# been switched on in Supabase answers "Unsupported provider" when a parent
# taps it, on the last screen before they pay us. Switch the provider on in
# Supabase first (Authentication, Sign In / Providers), then set this.
# Google is free. Apple needs a paid Apple Developer Program membership, so
# `google` on its own is a normal thing to run.
NEXT_PUBLIC_AUTH_PROVIDERS=
